# Copy this file to .env.local and fill in the values (.env.local is gitignored).
# In production, set these in the Vercel project's Environment Variables.

# Required for the AI chat. Without it, the chat falls back to local Q&A matching.
# Get one at https://console.anthropic.com/ → API Keys.
ANTHROPIC_API_KEY=

# Optional: per-IP rate limiting (20 messages/day). If unset, no rate limiting.
# Create a free Redis database at https://upstash.com/ and copy the REST creds.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Dev only: set to 1 to preview the "messages left" counter in local mode
# (counts free local replies so you can design the limit states without
# spending credits). Leave unset/empty in production.
NEXT_PUBLIC_FORCE_USAGE_UI=
